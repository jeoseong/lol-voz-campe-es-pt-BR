<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Falas dos Campeões - LoL</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h1>Falas do League of Legends</h1>
  
  <input type="text" id="search" placeholder="Buscar campeão..." onkeyup="filtrar()">

  <div class="champion-card">
    <h2>Evelynn</h2>
    <div class="quote">
      <p>"Tanto drama por um mero arranhão..."</p>
      <button onclick="playAudio('evelynn_quote1.mp3')">▶ Ouvir Áudio</button>
    </div>
  </div>
  <audio id="player"></audio>
  <script src="script.js"></script>
</body>
</html>
body {
  font-family: sans-serif;
  background-color: #0a0e17;
  color: #f0e6d2;
  padding: 15px;
}

input {
  width: 100%;
  padding: 12px;
  border-radius: 8px;
  border: 1px solid #c8aa6e;
  background: #010a13;
  color: #fff;
  margin-bottom: 20px;
}

.champion-card {
  background: #1e2328;
  border: 1px solid #c8aa6e;
  border-radius: 10px;
  padding: 15px;
  margin-bottom: 15px;
}

button {
  background: #c8aa6e;
  color: #1e2328;
  border: none;
  padding: 8px 15px;
  border-radius: 5px;
  font-weight: bold;
}
function playAudio(url) {
  const player = document.getElementById('player');
  player.src = url;
  player.play();
}
  